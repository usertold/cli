{
  "name": "usertold",
  "version": "3.0.1",
  "description": "Review source-linked interview Evidence and synthesize it into Findings from your terminal or coding agent.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usertold/cli.git"
  },
  "homepage": "https://usertold.ai/docs/cli",
  "bugs": {
    "url": "https://github.com/usertold/cli/issues"
  },
  "bin": {
    "usertold": "dist/usertold.js"
  },
  "files": [
    "dist/usertold.js",
    "README.md",
    "CHANGELOG.md",
    "docs/COMMAND_SURFACE.md",
    "docs/RELEASE_NOTES_1X.md",
    "LICENSE",
    "NOTICE",
    "TRADEMARKS.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate:routes": "tsx scripts/generate-cli-api-routes.ts",
    "build": "npm run generate:routes && node scripts/build.mjs",
    "typecheck": "npm run generate:routes && tsc --noEmit",
    "test": "npm run generate:routes && tsx --test src/cli/*.test.ts src/cli/lib/*.test.ts",
    "lint:boundary": "node scripts/check-public-boundary.mjs",
    "check": "npm run generate:routes && tsc --noEmit && tsx --test src/cli/*.test.ts src/cli/lib/*.test.ts && node scripts/build.mjs && npm run lint:boundary && npm run package:verify",
    "package:verify": "node scripts/verify-package.mjs",
    "prepack": "npm run build && npm run lint:boundary"
  },
  "keywords": [
    "user-research",
    "interviews",
    "evidence",
    "product",
    "cli",
    "agent"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.3.6"
  }
}
